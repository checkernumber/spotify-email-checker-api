    },
    "balance": {
      "method": "GET",
      "path": "/v1/balance"
    }
  },
  "input": {
    "file_format": "text file, one valid email address per line according to task type"
  },
  "products": [
    {
      "task_type": "spotify_email",
      "name": "Email Checker",
      "doc_slug": "spotify-email-checker",
      "input_kind": "email",
      "min_numbers": 1,
      "max_numbers": 10000000,
      "result_fields": [
        "email",
        "activated"
      ],
      "product_id": 36,
      "min_billable_numbers": 500,
      "available": true
    }
  ],
